{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "biome-format@melodic-software": false,
    "dometrain@melodic-software": false,
    "education@melodic-software": false,
    "evals@melodic-software": false,
    "event-storming@melodic-software": false,
    "go-format@melodic-software": false,
    "kindle-dedrm@melodic-software": false,
    "knowledge@melodic-software": false,
    "miro@melodic-software": false,
    "powershell-format@melodic-software": false,
    "ruff-format@melodic-software": false,
    "skill-quality@melodic-software": false,
    "songwriting@melodic-software": false
  },
  "extraKnownMarketplaces": {
    "melodic-software": {
      "source": {
        "source": "github",
        "repo": "melodic-software/claude-code-plugins"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-bootstrap.sh\"",
            "timeout": 600,
            "statusMessage": "Installing melodic-software plugins..."
          }
        ]
      }
    ]
  }
}
