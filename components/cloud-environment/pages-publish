#!/bin/bash
# melodic-software/standards cloud-environment pages-publish
# Exit codes: 2 usage, 3 input not a stamped temp-dir page, 4 credential
# content (here or at the host), 5 config missing or invalid, 6 upload failed.
set -u
export LC_ALL=C

die() {
  printf 'pages-publish: %s\n' "$2" >&2
  exit "$1"
}

usage() {
  printf 'usage: pages-publish <file> --visibility public|private [--id <id>]\n' >&2
  printf '       pages-publish --delete <id> --visibility public|private\n' >&2
  die 2 "$1"
}

id_re='^[A-Za-z0-9_-]{22}$'
file='' visibility='' page_id='' delete_id=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --visibility | --id | --delete)
      [[ $# -ge 2 ]] || usage "$1 needs a value"
      [[ "$1" != --visibility ]] || visibility="$2"
      [[ "$1" != --id ]] || page_id="$2"
      [[ "$1" != --delete ]] || delete_id="$2"
      shift 2
      ;;
    -*) usage "unknown option '$1'" ;;
    *)
      [[ -z "$file" ]] || usage "more than one file given"
      file="$1"
      shift
      ;;
  esac
done
[[ "$visibility" == public || "$visibility" == private ]] || usage '--visibility must be public or private'
if [[ -n "$delete_id" ]]; then
  [[ -z "$file" && -z "$page_id" ]] || usage '--delete takes no file and no --id'
  [[ "$delete_id" =~ $id_re ]] || usage "invalid id '$delete_id'"
else
  [[ -n "$file" ]] || usage 'missing <file>'
  [[ -z "$page_id" || "$page_id" =~ $id_re ]] || usage "invalid id '$page_id'"
fi

declare -A cfg=()
keys=(PUBLIC_ENDPOINT PRIVATE_ENDPOINT PUBLIC_TOKEN_SECRET PRIVATE_TOKEN_SECRET
  PRIVATE_ACCESS_ID_SECRET PRIVATE_ACCESS_KEY_SECRET)

parse_config() {
  local src="$1" line key value n=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    [[ -z "${line//[[:space:]]/}" || "$line" == '#'* ]] && continue
    key="${line%%=*}"
    [[ "$line" == *=* && "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die 5 "config $src: line $n is not KEY=VALUE"
    [[ " ${keys[*]} " == *" $key "* ]] || die 5 "config $src: unknown line '${key}'"
    cfg[$key]="${line#*=}"
  done
  for key in "${keys[@]}"; do
    value="${cfg[$key]:-}"
    [[ -n "$value" ]] || die 5 "config $src: $key is missing"
    if [[ "$key" == *_ENDPOINT ]]; then
      value="${value%/}"
      [[ "$value" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || die 5 "config $src: $key must be an https://<host> origin"
      cfg[$key]="$value"
    else
      [[ "$value" =~ ^[A-Za-z0-9-]{1,127}$ ]] || die 5 "config $src: $key is not a vault secret name"
    fi
  done
}

load_config() {
  local text secret=pages-publish-config
  command -v vault-exec >/dev/null 2>&1 ||
    die 5 "vault-exec is not on PATH to read Key Vault secret $secret"
  # shellcheck disable=SC2016 # expanded by the inner shell
  text="$(env -u VAULT_EXEC_VAULT -u PP_CONFIG vault-exec --env "PP_CONFIG=$secret" -- \
    bash -c 'printf "%s" "$PP_CONFIG"' 2>/dev/null)" ||
    die 5 "Key Vault secret $secret could not be read"
  [[ -n "${text//[[:space:]]/}" ]] || die 5 "Key Vault secret $secret is empty"
  parse_config "Key Vault secret $secret" <<<"$text"
}

load_config

send() {
  local vis="$1" method="$2" path="$3" data="${4:-}" prefix envs resp rc
  prefix="${vis^^}"
  unset PP_TOKEN PP_ACCESS_ID PP_ACCESS_KEY
  envs=(--env "PP_TOKEN=${cfg[${prefix}_TOKEN_SECRET]}")
  if [[ "$vis" == private ]]; then
    envs+=(--env "PP_ACCESS_ID=${cfg[PRIVATE_ACCESS_ID_SECRET]}"
      --env "PP_ACCESS_KEY=${cfg[PRIVATE_ACCESS_KEY_SECRET]}")
  fi
  # shellcheck disable=SC2016 # expanded by the inner shell
  resp="$(env -u VAULT_EXEC_VAULT vault-exec "${envs[@]}" -- bash -c '
    set -u
    bad="[\"\\\\[:cntrl:]]"
    for v in "$PP_TOKEN" "${PP_ACCESS_ID-}" "${PP_ACCESS_KEY-}"; do
      if [[ "$v" =~ $bad ]]; then
        echo "pages-publish: a resolved secret holds a character curl config cannot carry" >&2
        exit 97
      fi
    done
    url="$1" method="$2" data="$3"
    # -q must stay first: it stops curl reading a .curlrc from CURL_HOME,
    # XDG_CONFIG_HOME or HOME, which could add a url line and leak the headers.
    args=(-q -sS --proto =https --max-time 120 --config - -X "$method" -w "\n%{http_code}")
    [[ -z "$data" ]] || args+=(-H "Content-Type: text/html; charset=utf-8" --data-binary "@$data")
    {
      printf "header = \"Authorization: Bearer %s\"\n" "$PP_TOKEN"
      if [[ -n "${PP_ACCESS_ID-}" ]]; then
        printf "header = \"CF-Access-Client-Id: %s\"\n" "$PP_ACCESS_ID"
        printf "header = \"CF-Access-Client-Secret: %s\"\n" "$PP_ACCESS_KEY"
      fi
    } | curl "${args[@]}" "$url"
  ' pages-publish "${cfg[${prefix}_ENDPOINT]}$path" "$method" "$data")"
  rc=$?
  [[ $rc -eq 0 ]] || die 6 "$method ${cfg[${prefix}_ENDPOINT]}$path failed (exit $rc)"
  status="${resp##*$'\n'}"
  body="${resp%$'\n'*}"
  [[ "$resp" == *$'\n'* ]] || body=''
}

if [[ -n "$delete_id" ]]; then
  send "$visibility" DELETE "/_upload/$delete_id"
  [[ "$status" == 204 ]] || die 6 "DELETE returned HTTP $status"
  exit 0
fi

tmp_root="$(realpath -e -- "${TMPDIR:-/tmp}" 2>/dev/null)" || die 3 "temp dir ${TMPDIR:-/tmp} does not exist"
real="$(realpath -e -- "$file" 2>/dev/null)" || die 3 "$file does not exist"
[[ -f "$real" && "$real" == "$tmp_root"/* ]] || die 3 "$file is not a regular file under $tmp_root"
stamp_re='<!-- rv-gen:[A-Za-z0-9._-]+ sha256:[0-9a-f]{64} -->'
grep -aqE -- "$stamp_re" "$real" || die 3 "$file carries no builder stamp <!-- rv-gen:<name> sha256:<64 hex> -->"

w='(^|[^A-Za-z0-9_])'
hx='[0-9a-f]'
nhx='[^0-9a-f]'
secret_labels=(
  'private key' 'AWS access key' 'GitHub token' 'Anthropic key' 'OpenAI key'
  'Slack token' 'Stripe key' 'password or secret assignment' 'R2 key pair'
  'R2 key label' 'Azure client secret' 'Cloudflare API token' 'page upload token'
)
secret_res=(
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  "${w}(AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}([^A-Za-z0-9_]|$)"
  "${w}(gh[pousr]_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{82})"
  "${w}sk-ant-[A-Za-z0-9_-]{20,}"
  "${w}sk-(proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}"
  "${w}xox[abposr]-[0-9A-Za-z-]{10,}"
  "${w}[sr]k_(test|live|prod)_[0-9A-Za-z]{10,}"
  "${w}([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Pp][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Ll][Ii][Ee][Nn][Tt]_[Ss][Ee][Cc][Rr][Ee][Tt]|[Aa][Pp][Ii]_?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn])[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"'[:space:]\$<>{}]{8,}[\"']"
  "(^|${nhx})(${hx}{32}${nhx}(.*${nhx})?${hx}{64}|${hx}{64}${nhx}(.*${nhx})?${hx}{32})(${nhx}|$)"
  "(accessKeyId|secretAccessKey)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9/+=]{16,}"
  "(^|[^A-Za-z0-9_~.-])[A-Za-z0-9_~.]{3}[0-9]Q~[A-Za-z0-9_~.-]{31,34}([^A-Za-z0-9_~.-]|$)"
  "${w}(cfut|cfat|cfk)_[A-Za-z0-9]{40}"
  "${w}pgup_[A-Za-z0-9_-]{16,}"
)
private_labels=(
  'Linux home path' 'macOS home path' 'Windows user path' 'WSL share path'
  'WSL mount path' 'root home path' 'scratchpad slug' 'private hostname'
)
private_res=(
  '/home/[A-Za-z0-9._-]+/'
  '/Users/[A-Za-z0-9._-]+/'
  '[A-Za-z]:\\+Users\\+'
  '\\\\+wsl'
  '/mnt/[a-z]/Users/'
  '(^|[^A-Za-z0-9._-])/root/'
  '-home-[A-Za-z0-9._]+-'
  "(^|[^A-Za-z0-9.-])[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.(local|internal|lan)([^A-Za-z0-9_.-]|\.[^A-Za-z0-9_-]|\.?$)"
)

HPP_WIN_USER_BODY='[A-Za-z]:(/|\\\\?)Users(/|\\\\?)[^\\$%<{~"[:space:]/]([^\\$%<{~"[:space:]/]|%[0-9])*(~[0-9]+)?'
HPP_MACOS_USER_BODY='/Users/[^\\$%<{~"[:space:]/]([^\\$%<{~"[:space:]/]|%[0-9])*'
HPP_LINUX_USER_BODY='/home/[^\\$%<{~"[:space:]/]([^\\$%<{~"[:space:]/]|%[0-9])*'
HPP_WIN_REPO_BODY='[A-Za-z]:(/|\\\\?)(repos|Repos|projects|Projects|dev|Dev)(/|\\\\?)[^\\$%<{~"[:space:]/]([^\\$%<{~"[:space:]/]|%[0-9])*(~[0-9]+)?'
HPP_ESCAPED_WIN_REPO_BODY='[A-Za-z]:\\\\(repos|Repos|projects|Projects|dev|Dev)\\\\[^\\$%<{~"[:space:]/]([^\\$%<{~"[:space:]/]|%[0-9])*(~[0-9]+)?'
slash='(^|[^A-Za-z0-9._-])'
decoded_labels=(
  'Windows user path' 'macOS home path' 'Linux home path' 'Windows checkout path'
  'Windows checkout path'
)
decoded_res=(
  "$HPP_WIN_USER_BODY" "$slash$HPP_MACOS_USER_BODY" "$slash$HPP_LINUX_USER_BODY"
  "$HPP_WIN_REPO_BODY" "$HPP_ESCAPED_WIN_REPO_BODY"
)

# shellcheck disable=SC2016 # an awk program, not shell
decode_awk='
function hexval(s, i, v) {
  if (length(s) > 8) return 1114112
  s = tolower(s)
  for (i = 1; i <= length(s); i++) v = v * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
  return v
}
function utf8(n) {
  if (n < 1 || n > 1114111) n = 65533
  if (n < 128) return sprintf("%c", n)
  if (n < 2048) return sprintf("%c%c", 192 + int(n / 64), 128 + n % 64)
  if (n < 65536) return sprintf("%c%c%c", 224 + int(n / 4096), 128 + int(n / 64) % 64, 128 + n % 64)
  return sprintf("%c%c%c%c", 240 + int(n / 262144), 128 + int(n / 4096) % 64, 128 + int(n / 64) % 64, 128 + n % 64)
}
BEGIN {
  RS = mode == "tags" ? "<" : mode == "entities" ? "&" : "\\"
  names = "amp & lt < gt > quot \" apos \047"
  if (wide) names = names " sol / bsol \\ colon : period . lowbar _ equals = num # commat @"
  k = split(names, e, " ")
  for (i = 1; i < k; i += 2) named[e[i]] = e[i + 1]
  named["nbsp"] = " "
  pending = 1
}
NR == 1 { printf "%s", $0; next }
mode == "tags" { i = index($0, ">"); printf "%s", (i ? substr($0, i + 1) : "<" $0); next }
mode == "entities" {
  r = $0
  if (match(r, /^#[xX][0-9A-Fa-f]+/)) n = hexval(substr(r, 3, RLENGTH - 2))
  else if (match(r, /^#[0-9]+/)) n = RLENGTH > 9 ? 1114112 : substr(r, 2, RLENGTH - 1) + 0
  else {
    if (match(r, /^[A-Za-z]+;/) && (tolower(substr(r, 1, RLENGTH - 1)) in named))
      printf "%s%s", named[tolower(substr(r, 1, RLENGTH - 1))], substr(r, RLENGTH + 1)
    else printf "&%s", r
    next
  }
  if (substr(r, RLENGTH + 1, 1) == ";") RLENGTH++
  else if (!wide) { printf "&%s", r; next }
  printf "%s%s", utf8(n), substr(r, RLENGTH + 1)
  next
}
{
  r = $0
  if (!pending) { printf "%s", r; pending = 1; next }
  if (r == "") { printf "%s", "\\"; pending = 0; next }
  c = substr(r, 1, 1)
  if (!wide) r = "\\" r
  else if (c == "u" && match(r, /^u[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/)) r = utf8(hexval(substr(r, 2, 4))) substr(r, 6)
  else if (c == "u" && match(r, /^u[{][0-9A-Fa-f]+[}]/)) r = utf8(hexval(substr(r, 3, RLENGTH - 3))) substr(r, RLENGTH + 1)
  else if (c == "x" && match(r, /^x[0-9A-Fa-f][0-9A-Fa-f]/)) r = utf8(hexval(substr(r, 2, 2))) substr(r, 4)
  else if (c != "/" && c != "\"" && c != "\047") r = "\\" r
  printf "%s", r
}'

scan_dir="$(mktemp -d)" || die 6 'cannot create a scan copy'
trap 'rm -rf "$scan_dir"' EXIT
scan_copy="$scan_dir/page" host_copy="$scan_dir/host" wide_copy="$scan_dir/wide"
sed -E "s/$stamp_re//g" "$real" >"$scan_copy" || die 6 'cannot create a scan copy'
{ cat "$scan_copy" && printf '\n'; } | awk -v mode=tags "$decode_awk" >"$scan_dir/untagged" ||
  die 6 'cannot create a decoded scan copy'
for wide in 0 1; do
  copy="$host_copy"
  [[ $wide == 0 ]] || copy="$wide_copy"
  awk -v mode=entities -v wide="$wide" "$decode_awk" "$scan_dir/untagged" |
    awk -v mode=escapes -v wide="$wide" "$decode_awk" >"$copy" ||
    die 6 'cannot create a decoded scan copy'
done

for copy in "$scan_copy" "$host_copy"; do
  where=line
  [[ "$copy" == "$scan_copy" ]] || where='decoded line'
  for i in "${!secret_res[@]}"; do
    hit="$(grep -anE -m1 -- "${secret_res[$i]}" "$copy" | cut -d: -f1)"
    [[ -z "$hit" ]] || die 4 "refused: $where $hit looks like a ${secret_labels[$i]}"
  done
done
have_gitleaks=0
if command -v gitleaks >/dev/null 2>&1; then
  have_gitleaks=1
  gitleaks dir --no-banner --redact "$scan_copy" >/dev/null 2>&1
  [[ $? -ne 1 ]] || die 4 'refused: gitleaks found a credential'
fi

reason=''
for i in "${!secret_res[@]}"; do
  hit="$(grep -anE -m1 -- "${secret_res[$i]}" "$wide_copy" | cut -d: -f1)"
  [[ -z "$hit" ]] || {
    reason="${secret_labels[$i]} on decoded line $hit"
    break
  }
done
for copy in "$host_copy" "$wide_copy"; do
  [[ -z "$reason" && $have_gitleaks == 1 ]] || break
  gitleaks dir --no-banner --redact "$copy" >/dev/null 2>&1
  [[ $? -ne 1 ]] || reason='gitleaks finding in a decoded copy'
done
for i in "${!private_res[@]}"; do
  [[ -z "$reason" ]] || break
  ! grep -aqE -- "${private_res[$i]}" "$scan_copy" "$host_copy" "$wide_copy" ||
    reason="${private_labels[$i]}"
done
for i in "${!decoded_res[@]}"; do
  [[ -z "$reason" ]] || break
  ! grep -aqE -- "${decoded_res[$i]}" "$wide_copy" || reason="${decoded_labels[$i]}"
done
sent="$visibility"
if [[ -n "$reason" ]]; then
  [[ "$sent" == private ]] ||
    printf 'pages-publish: sending private: the page holds a %s\n' "$reason" >&2
  sent=private
fi
[[ "$sent" == "$visibility" ]] || page_id=''

send "$sent" PUT "/_upload${page_id:+/$page_id}" "$real"
if [[ "$status" == 409 && "$sent" == public && "$body" == private-required ]]; then
  printf 'pages-publish: the public host requires private; creating a private page\n' >&2
  sent=private
  page_id=''
  send private PUT /_upload "$real"
fi
[[ "$status" != 422 ]] || die 4 "refused by the host: ${body:0:80}"
[[ "$status" == 200 || "$status" == 201 ]] || die 6 "PUT returned HTTP $status"
url="${body%%$'\n'*}"
url="${url%$'\r'}"
[[ "$url" =~ ^https://[^[:space:]\"\\]+$ ]] || die 6 'the host returned no page URL'
returned_id="${url%/}"
returned_id="${returned_id##*/}"
[[ "$returned_id" =~ $id_re ]] || die 6 "no page id in the returned URL $url"
[[ -z "$page_id" || "$returned_id" == "$page_id" ]] || die 6 "the host replaced $page_id but returned $returned_id"
printf '{"id":"%s","visibility":"%s","url":"%s"}\n' "$returned_id" "$sent" "$url"
