#!/bin/bash
# melodic-software/standards cloud-environment vault-exec
set -u

usage() {
  printf 'vault-exec: %s\n' "$1" >&2
  printf 'usage: vault-exec [--optional] --env NAME=secret-name [--env ...] -- <command> [args...]\n' >&2
  exit 2
}

optional=0
names=()
secrets=()
while [[ $# -gt 0 && "$1" != '--' ]]; do
  case "$1" in
    --optional)
      optional=1
      shift
      ;;
    --env)
      [[ $# -ge 2 ]] || usage '--env needs NAME=secret-name'
      pair="$2"
      name="${pair%%=*}"
      secret="${pair#*=}"
      [[ "$pair" == *=* && "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
        usage "invalid --env '$pair': NAME must be an environment variable name"
      [[ "$secret" =~ ^[A-Za-z0-9-]{1,127}$ ]] ||
        usage "invalid secret name for $name: alphanumerics and hyphens, 1-127 characters"
      names+=("$name")
      secrets+=("$secret")
      shift 2
      ;;
    *) usage "unknown argument '$1'" ;;
  esac
done
[[ $# -gt 0 ]] || usage "missing '--' before the command"
shift
[[ $# -gt 0 ]] || usage 'missing command after --'
[[ ${#names[@]} -gt 0 ]] || usage 'at least one --env NAME=secret-name is required'

vault="${VAULT_EXEC_VAULT:-kv-melo-devtools-prod}"
[[ "$vault" =~ ^[A-Za-z][A-Za-z0-9-]{1,22}[A-Za-z0-9]$ ]] ||
  usage "invalid VAULT_EXEC_VAULT '$vault': 3-24 alphanumerics and hyphens"
# No auth header: the agent proxy adds the environment's secret to the request:
# https://code.claude.com/docs/en/cloud-environments#add-network-secrets

budget="${VAULT_EXEC_BUDGET_SEC:-45}"
delay="${VAULT_EXEC_RETRY_DELAY_SEC:-1}"
deadline=$((SECONDS + budget))

# -q must stay first: only then does curl skip every .curlrc, which could redirect
# the response or the proxy's token: https://curl.se/docs/manpage.html#-q
fetch() {
  local max=$((deadline - SECONDS))
  [[ $max -le 10 ]] || max=10
  resp="$(curl -q -sS --fail-with-body --proto '=https' --connect-timeout 5 \
    --max-time "$max" -w '\n%{http_code}' "$1" </dev/null 2>/dev/null)"
  curl_rc=$?
}

failed=0
for i in "${!names[@]}"; do
  name="${names[$i]}"
  secret="${secrets[$i]}"
  url="https://${vault}.vault.azure.net/secrets/${secret}?api-version=7.4"
  resp=''
  curl_rc=0
  status=''
  for attempt in 1 2 3; do
    if [[ $((deadline - SECONDS)) -lt 1 ]]; then
      status="${status:-none}, time budget spent"
      break
    fi
    fetch "$url"
    status="${resp##*$'\n'}"
    if [[ $curl_rc -eq 0 ]] ||
      [[ $curl_rc -eq 22 && ! "$status" =~ ^(408|429|5[0-9][0-9])$ ]]; then
      break
    fi
    [[ $attempt -eq 3 ]] || sleep "$delay"
  done
  body="${resp%$'\n'*}"
  value=''
  if [[ $curl_rc -eq 0 && "$status" == 200 ]]; then
    # The x sentinel survives the trailing-newline strip of $(...); -I keeps the cwd and
    # PYTHON* off sys.path: https://docs.python.org/3/using/cmdline.html#cmdoption-I
    if value="$(printf '%s' "$body" | python3 -I -c '
import json, sys
v = json.load(sys.stdin).get("value")
if not isinstance(v, str):
    sys.exit(1)
sys.stdout.write(v + "x")
' 2>/dev/null)"; then
      value="${value%x}"
    else
      value=''
      status="$status, no string value in the response"
      curl_rc=0
    fi
  fi
  unset resp body
  if [[ $curl_rc -eq 0 && "$status" == 200 ]]; then
    export "${name}=${value}"
  elif [[ $optional -eq 1 ]]; then
    unset "$name"
    printf "vault-exec: %s not set: secret '%s' in %s failed (HTTP %s, curl exit %s); starting without it\n" \
      "$name" "$secret" "$vault" "${status:-none}" "$curl_rc" >&2
  else
    printf "vault-exec: secret '%s' in %s failed (HTTP %s, curl exit %s)\n" \
      "$secret" "$vault" "${status:-none}" "$curl_rc" >&2
    failed=1
  fi
  unset value
done
[[ $failed -eq 0 ]] || exit 1

exec "$@"
