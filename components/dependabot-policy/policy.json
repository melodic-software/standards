{
  "schemaVersion": 1,
  "scheduleInterval": "weekly",
  "cooldownMinimumDays": 3,
  "maxOpenPullRequests": 5,
  "requireGroups": true,
  "autoMerge": {
    "ecosystems": ["github-actions"],
    "publisherAllowlist": ["actions/*", "github/*", "anthropics/*"],
    "excludeSemverMajor": true,
    "requiredCheck": "ci-status"
  }
}
