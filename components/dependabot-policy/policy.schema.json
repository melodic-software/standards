{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.melodic.software/dependabot-policy/policy.schema.json",
  "title": "Dependabot policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scheduleInterval",
    "cooldownMinimumDays",
    "maxOpenPullRequests",
    "requireGroups",
    "autoMerge"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scheduleInterval": { "enum": ["daily", "weekly", "monthly"] },
    "cooldownMinimumDays": { "type": "integer", "minimum": 1 },
    "maxOpenPullRequests": { "type": "integer", "minimum": 1 },
    "requireGroups": { "type": "boolean" },
    "autoMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystems", "publishers", "excludeSemverMajor", "requiredCheck"],
      "properties": {
        "ecosystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publishers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/\\*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "reviewed", "basis"],
            "properties": {
              "tier": { "enum": ["auto", "manual"] },
              "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "basis": { "type": "string", "minLength": 1 }
            }
          }
        },
        "excludeSemverMajor": { "type": "boolean" },
        "requiredCheck": { "type": "string", "minLength": 1 }
      }
    }
  }
}
