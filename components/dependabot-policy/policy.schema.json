{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.melodic.software/dependabot-policy/policy.schema.json",
  "title": "Dependabot policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scheduleInterval",
    "cooldownMinimumDays",
    "maxOpenPullRequests",
    "requireGroups",
    "autoMerge"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scheduleInterval": { "enum": ["daily", "weekly", "monthly"] },
    "cooldownMinimumDays": { "type": "integer", "minimum": 1 },
    "maxOpenPullRequests": { "type": "integer", "minimum": 1 },
    "requireGroups": { "type": "boolean" },
    "autoMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystems", "publisherAllowlist", "excludeSemverMajor", "requiredCheck"],
      "properties": {
        "ecosystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publisherAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/\\*$" }
        },
        "excludeSemverMajor": { "type": "boolean" },
        "requiredCheck": { "type": "string", "minLength": 1 }
      }
    }
  }
}
