{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.melodic.software/github-actions-conventions/rename-map.schema.json",
  "title": "GitHub Actions rename map",
  "description": "One entry per workflow file or composite action whose path changes under the naming conventions. `to` is the new path, or a parenthesized disposition when the file folds into another one and is deleted.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "repo",
      "kind",
      "from",
      "to",
      "from_name",
      "to_name",
      "job_renames",
      "couplings",
      "note"
    ],
    "properties": {
      "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
      "kind": { "enum": ["workflow", "action"] },
      "from": { "$ref": "#/$defs/path" },
      "to": {
        "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "string", "pattern": "^\\(.+\\)$" }]
      },
      "from_name": { "type": ["string", "null"] },
      "to_name": { "type": ["string", "null"] },
      "job_renames": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/jobId" },
            "to": { "$ref": "#/$defs/jobId" }
          }
        }
      },
      "couplings": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "ACTIONLINT",
            "GOV",
            "GOV-TESTS",
            "HOSTED-FLEET",
            "MFG",
            "OIDC",
            "PIN",
            "PULUMI-GUARD",
            "RC",
            "REPIN",
            "RP-repo",
            "RP-std",
            "SELF",
            "SYNC",
            "TRIGGER",
            "WR"
          ]
        }
      },
      "confidence": { "enum": ["high", "medium"] },
      "consumers": { "type": "string", "minLength": 1 },
      "note": { "type": "string" }
    },
    "allOf": [
      {
        "if": { "properties": { "kind": { "const": "workflow" } } },
        "then": {
          "required": ["confidence"],
          "properties": {
            "confidence": { "enum": ["high", "medium"] },
            "from": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" }
          }
        }
      },
      {
        "if": { "properties": { "kind": { "const": "action" } } },
        "then": {
          "required": ["consumers"],
          "properties": {
            "consumers": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "pattern": "^\\.github/actions/[a-z0-9-]+(/[a-z0-9-]+)?$" },
            "job_renames": { "type": "array", "maxItems": 0 }
          }
        }
      }
    ]
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" },
    "jobId": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" }
  }
}
