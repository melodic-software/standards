{
  "schemaVersion": 2,
  "title": {
    "allowedTypes": [
      "build",
      "chore",
      "ci",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "security",
      "style",
      "test"
    ],
    "requireScope": false
  },
  "body": {
    "requiredSections": ["Summary", "Fix", "Verification", "Related"],
    "closingKeywords": ["Closes", "Fixes", "Resolves"],
    "noIssueMarkers": ["No linked issue", "No related issue"],
    "nonClosingMarkers": ["Refs", "Relates to"],
    "negatedClosers": {
      "triggerWords": ["not", "never", "no", "without", "deliberately", "intentionally"],
      "triggerSuffixes": ["n't"],
      "affirmativePhrases": ["not only"],
      "wordWindow": 5
    }
  }
}
