{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.melodic.software/pr-convention-policy/policy.schema.json",
  "title": "PR convention policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "body"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTypes", "requireScope"],
      "properties": {
        "allowedTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        },
        "requireScope": { "type": "boolean" }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredSections",
        "closingKeywords",
        "noIssueMarkers",
        "nonClosingMarkers",
        "negatedClosers"
      ],
      "properties": {
        "requiredSections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closingKeywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]*$"
          }
        },
        "noIssueMarkers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonClosingMarkers": {
          "description": "Markers that link an issue without closing it: a line holding only `<marker>: [owner/repo]#N`, indented at most three spaces, matched case-insensitively.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]*( [a-z]+)*$"
          }
        },
        "negatedClosers": {
          "description": "A closing reference preceded by a disclaimer fails outright, because GitHub's parser ignores the disclaimer and still closes the issue. The disclaimer is searched among the last `wordWindow` words between the previous `.!?;,` and the keyword.",
          "type": "object",
          "additionalProperties": false,
          "required": ["triggerWords", "triggerSuffixes", "affirmativePhrases", "wordWindow"],
          "properties": {
            "triggerWords": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z]+$" }
            },
            "triggerSuffixes": {
              "type": "array",
              "description": "The composite implements exactly one suffix test, which the lockstep extractor reads; widening this needs both copies and the extractors to change together.",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z']+$" }
            },
            "affirmativePhrases": {
              "type": "array",
              "description": "Both linkage copies implement exactly one affirmative exception, which the lockstep extractors read; widening this needs both copies and the extractors to change together.",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z]+ [a-z]+$" }
            },
            "wordWindow": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
